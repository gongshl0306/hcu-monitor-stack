      "targets": [
        {
          "expr": "avg(sglang:token_usage{instance=~\"$instance\"}) by (instance)",
          "legendFormat": "{{{{instance}}}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hcu-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "percentage",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "11.1.0"
    },
