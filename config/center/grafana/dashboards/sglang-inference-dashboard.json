{
  "uid": "sglang-inference",
  "title": "SGLang Inference Monitor",
  "tags": [
    "sglang",
    "llm"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 38,
  "version": 8,
  "weekStart": "",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "style": "dark",
  "id": null,
  "gnetId": null,
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "server",
        "label": "服务:",
        "query": {
          "query": "label_values(up{job=\"sglang\"}, server)",
          "refId": "PrometheusVariableQueryEditor-server"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "hcu-prometheus"
        },
        "type": "query",
        "refresh": 1,
        "regex": "",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "options": [],
        "skipUrlSync": false,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "model",
        "label": "model:",
        "query": {
          "query": "label_values(sglang_num_running_reqs, model_name)",
          "refId": "PrometheusVariableQueryEditor-model"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "hcu-prometheus"
        },
        "type": "query",
        "refresh": 1,
        "regex": "",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "options": [],
        "skipUrlSync": false,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "服务状态 (up)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "hcu-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "up{job=\"sglang\",server=~\"$server\"}",
          "legendFormat": "{{server}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hcu-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "pluginVersion": "11.1.0"
    },
    {
      "id": 2,
      "title": "运行中请求",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "hcu-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(sglang_num_running_reqs{server=~\"$server\"}) by (name)",
