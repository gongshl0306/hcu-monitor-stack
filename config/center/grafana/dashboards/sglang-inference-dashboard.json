{
  "uid": "sglang-inference",
  "title": "SGLang Inference Monitor",
  "tags": [
    "sglang",
    "llm"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 38,
  "version": 1,
  "weekStart": "",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "style": "dark",
  "id": null,
  "gnetId": null,
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "instance:",
        "query": {
          "query": "label_values(up{job=\"sglang\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-instance"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "hcu-prometheus"
        },
        "type": "query",
        "refresh": 1,
        "regex": "",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "options": [],
        "skipUrlSync": false,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "model",
        "label": "model:",
        "query": {
          "query": "label_values(sglang:num_running_reqs, model_name)",
          "refId": "PrometheusVariableQueryEditor-model"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "hcu-prometheus"
        },
        "type": "query",
        "refresh": 1,
        "regex": "",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "options": [],
        "skipUrlSync": false,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "服务状态 (up)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "hcu-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "up{job=\"sglang\",instance=~\"$instance\"}",
          "legendFormat": "{{{{instance}}}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hcu-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "pluginVersion": "11.1.0"
    },
    {
      "id": 2,
      "title": "运行中请求",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "hcu-prometheus"
