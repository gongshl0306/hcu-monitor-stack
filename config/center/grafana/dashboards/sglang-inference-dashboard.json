      "targets": [
        {
          "expr": "avg(sglang_token_usage{server=~\"$server\"}) by (name)",
          "legendFormat": "{{server}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hcu-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "percentage",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "11.1.0"
    },
