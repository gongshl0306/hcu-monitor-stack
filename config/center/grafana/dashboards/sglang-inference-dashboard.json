    {
      "id": 4,
      "title": "KV cache 使用率",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "hcu-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
