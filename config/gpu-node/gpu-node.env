# GPU 计算节点 —— hcu-exporter 运行参数
# 由 deploy.sh 在 GPU 节点上读取。改这里即可调整采集行为，无需改脚本。

# 监听端口（中心节点 Prometheus 会 scrape 这个端口）
PORT=16080

# 裸机 false；K8s 节点 true
CONNECT_K8S=false

# 访问白名单：留空=不限制；如 "127.0.0.1,10.0.0.0/8"
ALLOWED_IPS=

# 关键：8 卡节点必须用精选指标，不能用 METRICS_LEVEL=medium/high。
# 默认 medium(81 指标)/high 在 8 卡下单轮采集 ~60s，会被 exporter 内置看门狗
# （单轮超 60s 未更新即 os.Exit(1)）反复杀掉。下面 19 个指标覆盖全部告警规则
# + 面板核心，单轮 ~5s，稳定运行。
ENABLE_METRICS=hcu_temp,hcu_power_usage,hcu_powercap,hcu_utilizationrate,hcu_usedmemory_bytes,hcu_memorycap_bytes,hcu_vram_percent,hcu_sclk,hcu_mclk,hcu_fan_rpm,hcu_pcie_width,hcu_pcie_clock,hcu_temp_mem,hcu_health_status,hcu_throttle,hcu_ce_count_total,hcu_ue_count_total,hcu_bad_pages,hcu_process_vram_used_bytes
